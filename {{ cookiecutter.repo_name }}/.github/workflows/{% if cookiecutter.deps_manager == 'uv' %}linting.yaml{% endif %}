name: Code linting

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

jobs:
  format:
    name: Check code formatting
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["PLACEHOLDER_FOR_PYTHON_VERSION"]  # Add more versions if desired

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
          cache: 'uv'

      - name: Install dependencies
        run: |
          python -m pip install -U uv setuptools wheel
          uv sync

      - name: Ruff lint
        run: uv run ruff check . --verbose

      - name: Ruff format
        run: uv run ruff format . --verbose